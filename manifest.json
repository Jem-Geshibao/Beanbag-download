{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "豆包无水印下载助手",
  "version": "1.1.1",
  "description": "一键获取豆包AI生成图片的无水印原图，支持快速下载",
  "author": "Jem Geshibao",
  "icons": {
    "16": "icons/icon16.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["downloads", "tabs", "scripting"],
  "host_permissions": ["*://*.doubao.com/*", "*://*.byteimg.com/*"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    },
    "default_title": "豆包无水印下载助手",
    "default_popup": "html/options.html"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.doubao.com/*"],
      "js": ["js/content.js"],
      "css": ["css/style.css"],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "html/options.html",
    "open_in_tab": false
  },
  "options_page": "html/about.html",
  "homepage_url": "https://github.com/Jem-Geshibao"
}
